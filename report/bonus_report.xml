<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_master_bonus" model="ir.actions.report">
        <field name="name">Master Bonus Report</field>
        <field name="model">beauty.salon.bonus.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">beauty_salon.report_master_bonus_template</field>
        <field name="report_file">beauty_salon.report_master_bonus_template</field>
        <field name="binding_model_id" ref="model_beauty_salon_bonus_wizard"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_master_bonus_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center mt-4">Master Bonus Report: <t t-esc="doc.master_id.name"/></h2>
                        <h4 class="text-center mb-4">Period: from <t t-esc="doc.date_start"/> to <t t-esc="doc.date_end"/></h4>
                        
                        <t t-set="appointments" t-value="env['beauty.salon.appointment'].search([('master_id', '=', doc.master_id.id), ('state', '=', 'done'), ('datetime_start', '&gt;=', doc.date_start), ('datetime_start', '&lt;=', doc.date_end)])"/>
                        
                        <table class="table table-sm table-bordered mt-4">
                            <thead class="thead-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Client</th>
                                    <th>Services</th>
                                    <th class="text-end">Total Amount</th>
                                    <th class="text-end">Master Bonus</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="total_bonus" t-value="0"/>
                                <tr t-foreach="appointments" t-as="app">
                                    <td><t t-esc="app.datetime_start.strftime('%Y-%m-%d %H:%M')"/></td>
                                    <td><t t-esc="app.client_id.name"/></td>
                                    <td><t t-esc="', '.join(app.service_ids.mapped('name'))"/></td>
                                    <td class="text-end">
                                        <span t-field="line.total_amount" t-options='{"widget": "monetary", "display_currency": o.master_id.currency_id}'/>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.master_bonus" t-options='{"widget": "monetary", "display_currency": o.master_id.currency_id}'/>
                                    </td>

                                    <p class="text-end">
                                        <strong>Total Bonus to Pay: </strong>
                                        <span t-esc="total_bonus" t-options='{"widget": "monetary", "display_currency": o.master_id.currency_id}'/>
                                    </p>
                                </tr>
                            </tbody>
                        </table>
                        
                        <div class="row mt-4">
                            <div class="col-12 text-end">
                                <h3>Total Bonus to Pay: <strong><t t-esc="total_bonus"/> UAH</strong></h3>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="view_beauty_bonus_wizard_form" model="ir.ui.view">
        <field name="name">beauty.salon.bonus.wizard.form</field>
        <field name="model">beauty.salon.bonus.wizard</field>
        <field name="arch" type="xml">
            <form string="Calculate Bonuses">
                <group>
                    <field name="master_id"/>
                    <group>
                        <field name="date_start"/>
                    </group>
                    <group>
                        <field name="date_end"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_report" string="Generate PDF" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_beauty_bonus_wizard" model="ir.actions.act_window">
        <field name="name">Calculate Bonuses</field>
        <field name="res_model">beauty.salon.bonus.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_beauty_bonus_wizard" name="Reporting (Bonuses)" parent="menu_beauty_root" action="action_beauty_bonus_wizard" sequence="50"/>

</odoo>