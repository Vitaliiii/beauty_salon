<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem id="menu_beauty_salon_root" name="Beauty Salon" sequence="10"/>
    <menuitem id="menu_beauty_directories" name="Configuration" parent="menu_beauty_salon_root" sequence="100"/>

    <record id="view_beauty_service_form" model="ir.ui.view">
        <field name="name">beauty.service.form</field>
        <field name="model">beauty.service</field>
        <field name="arch" type="xml">
            <form string="Service">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Service Name"/>
                        <h1><field name="name" placeholder="e.g. Men's Haircut"/></h1>
                    </div>
                    <group>
                        <group string="Pricing &amp; Time">
                            <field name="currency_id" invisible="1"/>
                            <field name="price" widget="monetary" string="Base Price"/>
                            <field name="duration" widget="float_time" string="Standard Duration"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Describe what is included in this service..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_beauty_service_tree" model="ir.ui.view">
        <field name="name">beauty.service.list</field>
        <field name="model">beauty.service</field>
        <field name="arch" type="xml">
            <list string="Services"> 
                <field name="name"/>
                <field name="price" widget="monetary"/>
                <field name="duration" widget="float_time"/>
                <field name="currency_id" column_invisible="True"/>
            </list> 
        </field>
    </record>

    <record id="view_beauty_appointment_calendar" model="ir.ui.view">
        <field name="name">beauty.appointment.calendar</field>
        <field name="model">beauty.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Salon Schedule" 
                      date_start="datetime_start" 
                      date_stop="datetime_end" 
                      color="master_id" 
                      mode="week">
                <field name="client_id" string="Customer"/>
                <field name="master_id" filters="1" string="Stylist"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_beauty_appointment_tree" model="ir.ui.view">
        <field name="name">beauty.appointment.list</field>
        <field name="model">beauty.appointment</field>
        <field name="arch" type="xml">
            <list string="Appointments" decoration-info="state == 'draft'" decoration-success="state == 'done'">
                <field name="datetime_start" string="Date &amp; Time"/>
                <field name="name" string="Order #"/>
                <field name="client_id" string="Customer"/>
                <field name="master_id" string="Stylist"/>
                <field name="total_amount" string="Total Price" widget="monetary" sum="Total Revenue"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'confirmed'" 
                       decoration-success="state == 'done'" 
                       decoration-muted="state == 'cancelled'"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_beauty_appointment_form" model="ir.ui.view">
        <field name="name">beauty.appointment.form</field>
        <field name="model">beauty.appointment</field>
        <field name="arch" type="xml">
            <form string="Appointment">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Appointment Number"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Customer &amp; Stylist">
                            <field name="client_id" string="Customer" placeholder="Select customer..."/>
                            <field name="master_id" string="Stylist" placeholder="Select master..."/>
                        </group>
                        <group string="Schedule">
                            <field name="datetime_start" string="Starts At"/>
                            <field name="datetime_end" string="Estimated End" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Services &amp; Payment" name="services">
                            <field name="service_ids" widget="many2many_tags" placeholder="Add services..." options="{'no_create': True}"/>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="currency_id" invisible="1"/>
                                <field name="total_amount" string="Total Due" widget="monetary" class="oe_subtotal_footer_separator"/>
                                <field name="master_bonus" string="Master's Bonus" widget="monetary"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_beauty_appointment_pivot" model="ir.ui.view">
        <field name="name">beauty.appointment.pivot</field>
        <field name="model">beauty.appointment</field>
        <field name="arch" type="xml">
            <pivot string="Sales Analysis">
                <field name="master_id" type="row"/>
                <field name="datetime_start" interval="month" type="col"/>
                <field name="total_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_beauty_appointment_graph" model="ir.ui.view">
        <field name="name">beauty.appointment.graph</field>
        <field name="model">beauty.appointment</field>
        <field name="arch" type="xml">
            <graph string="Appointments by Master" type="bar">
                <field name="master_id"/>
                <field name="total_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_beauty_master_schedule_tree" model="ir.ui.view">
        <field name="name">beauty.master.schedule.list</field>
        <field name="model">beauty.master.schedule</field>
        <field name="arch" type="xml">
            <list string="Working Hours" editable="bottom">
                <field name="master_id" string="Master"/>
                <field name="day_of_week" string="Day"/>
                <field name="hour_from" widget="float_time" string="Start Hour"/>
                <field name="hour_to" widget="float_time" string="End Hour"/>
            </list>
        </field>
    </record>

    <record id="view_beauty_review_tree" model="ir.ui.view">
        <field name="name">beauty.review.list</field>
        <field name="model">beauty.review</field>
        <field name="arch" type="xml">
            <list string="Customer Reviews">
                <field name="create_date" string="Date"/>
                <field name="client_id" string="Customer"/>
                <field name="master_id" string="Stylist"/>
                <field name="rating" widget="priority" string="Rating"/>
                <field name="comment" string="Feedback"/>
            </list>
        </field>
    </record>

    <record id="action_beauty_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">beauty.appointment</field>
        <field name="view_mode">calendar,list,form,pivot,graph</field>
    </record>

    <record id="action_beauty_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">beauty.service</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_beauty_review" model="ir.actions.act_window">
        <field name="name">Reviews</field>
        <field name="res_model">beauty.review</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_beauty_master_schedule" model="ir.actions.act_window">
        <field name="name">Working Hours</field>
        <field name="res_model">beauty.master.schedule</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_beauty_appointments" name="Appointments" parent="menu_beauty_salon_root" action="action_beauty_appointment" sequence="10"/>
    <menuitem id="menu_beauty_reviews" name="Reviews" parent="menu_beauty_salon_root" action="action_beauty_review" sequence="25"/>
    <menuitem id="menu_beauty_services" name="Services" parent="menu_beauty_directories" action="action_beauty_service" sequence="30"/>
    <menuitem id="menu_beauty_master_schedule" name="Working Hours" parent="menu_beauty_directories" action="action_beauty_master_schedule" sequence="40"/>

</odoo>