<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_beauty_salon" model="ir.module.category">
        <field name="name">Beauty Salon</field>
        <field name="description">Access levels for the Beauty Salon module.</field>
        <field name="sequence">10</field>
    </record>

    <record id="privilege_beauty_salon" model="res.groups.privilege">
        <field name="name">Beauty Roles</field>
        <field name="category_id" ref="module_category_beauty_salon"/>
    </record>

    <record id="group_beauty_master" model="res.groups">
        <field name="name">Master</field>
        <field name="privilege_id" ref="privilege_beauty_salon"/> 
        <field name="comment">The Master can read services and manage their own appointments.</field>
    </record>

    <record id="group_beauty_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_beauty_salon"/> 
        <field name="implied_ids" eval="[(4, ref('group_beauty_master'))]"/>
        <field name="comment">The Manager can manage all appointments, clients, and services.</field>
    </record>

    <record id="group_beauty_administrator" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_beauty_salon"/> 
        <field name="implied_ids" eval="[(4, ref('group_beauty_manager'))]"/>
        <field name="comment">Full access including financial reports and configuration.</field>
    </record>

    <record id="rule_beauty_appointment_master" model="ir.rule">
        <field name="name">Master: Own Appointments Only</field>
        <field name="model_id" ref="model_beauty_appointment"/>
        <field name="domain_force">[('master_id.master_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_beauty_master'))]"/>
    </record>

    <record id="rule_beauty_appointment_all" model="ir.rule">
        <field name="name">Manager/Admin: All Appointments</field>
        <field name="model_id" ref="model_beauty_appointment"/>
        <field name="domain_force">[(1, '=', 1)]</field> 
        <field name="groups" eval="[(4, ref('group_beauty_manager'))]"/>
    </record>

</odoo>