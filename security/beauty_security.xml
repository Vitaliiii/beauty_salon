<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record model="ir.module.category" id="module_category_beauty_salon">
            <field name="name">Beauty Salon</field>
            <field name="description">Access levels for Beauty Salon module</field>
            <field name="sequence">10</field>
        </record>

        <record model="res.groups.privilege" id="privilege_beauty_salon">
            <field name="name">Beauty Salon Privileges</field>
            <field name="category_id" ref="module_category_beauty_salon"/>
        </record>

        <record id="group_beauty_master" model="res.groups">
            <field name="name">Master</field>
            <field name="privilege_id" ref="privilege_beauty_salon"/>
        </record>

        <record id="group_beauty_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_beauty_salon"/>
            <field name="implied_ids" eval="[(4, ref('group_beauty_master'))]"/>
        </record>

        <record id="rule_appointment_personal_master" model="ir.rule">
            <field name="name">Personal Appointments for Master</field>
            <field name="model_id" ref="model_beauty_salon_appointment"/>
            <field name="domain_force">[('master_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('beauty_salon.group_beauty_master'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_appointment_all_manager" model="ir.rule">
            <field name="name">All Appointments for Manager</field>
            <field name="model_id" ref="model_beauty_salon_appointment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('beauty_salon.group_beauty_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>