<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="demo_service_haircut" model="beauty.service">
            <field name="name">Men's Haircut</field>
            <field name="price">550.0</field>
            <field name="duration">1.0</field>
        </record>

        <record id="demo_service_coloring" model="beauty.service">
            <field name="name">Premium Hair Coloring</field>
            <field name="price">2500.0</field>
            <field name="duration">3.0</field>
        </record>

        <record id="demo_service_manicure" model="beauty.service">
            <field name="name">Shellac Manicure</field>
            <field name="price">700.0</field>
            <field name="duration">1.5</field>
        </record>

        <record id="demo_service_massage" model="beauty.service">
            <field name="name">Deep Tissue Massage</field>
            <field name="price">1300.0</field>
            <field name="duration">1.0</field>
        </record>

        <record id="demo_master_olena" model="res.partner">
            <field name="name">Olena Styles (Hair)</field>
            <field name="beauty_role">master</field>
            <field name="bonus_percentage">30.0</field>
            <field name="specialty_ids" eval="[(4, ref('demo_service_haircut')), (4, ref('demo_service_coloring'))]"/>
        </record>

        <record id="demo_master_igor" model="res.partner">
            <field name="name">Igor Nails (Manicure)</field>
            <field name="beauty_role">master</field>
            <field name="bonus_percentage">40.0</field>
            <field name="specialty_ids" eval="[(4, ref('demo_service_manicure'))]"/>
        </record>

        <record id="demo_master_natalia" model="res.partner">
            <field name="name">Natalia Zen (Massage)</field>
            <field name="beauty_role">master</field>
            <field name="bonus_percentage">35.0</field>
            <field name="specialty_ids" eval="[(4, ref('demo_service_massage'))]"/>
        </record>

        <record id="sched_olena_week" model="beauty.master.schedule">
            <field name="master_id" ref="demo_master_olena"/>
            <field name="day_of_week">0</field> <field name="hour_from">9.0</field>
            <field name="hour_to">20.0</field>
        </record>
        <record id="sched_olena_tue" model="beauty.master.schedule">
            <field name="master_id" ref="demo_master_olena"/>
            <field name="day_of_week">1</field>
            <field name="hour_from">9.0</field>
            <field name="hour_to">20.0</field>
        </record>
        <record id="sched_igor_tue" model="beauty.master.schedule">
            <field name="master_id" ref="demo_master_igor"/>
            <field name="day_of_week">1</field>
            <field name="hour_from">10.0</field>
            <field name="hour_to">19.0</field>
        </record>
        <record id="sched_igor_thu" model="beauty.master.schedule">
            <field name="master_id" ref="demo_master_igor"/>
            <field name="day_of_week">3</field>
            <field name="hour_from">10.0</field>
            <field name="hour_to">19.0</field>
        </record>

        <record id="sched_natalia_wed" model="beauty.master.schedule">
            <field name="master_id" ref="demo_master_natalia"/>
            <field name="day_of_week">2</field>
            <field name="hour_from">8.0</field>
            <field name="hour_to">16.0</field>
        </record>

        <record id="demo_client_1" model="res.partner">
            <field name="name">Оксана Ковальчук</field>
            <field name="beauty_role">client</field>
        </record>
        <record id="demo_client_2" model="res.partner">
            <field name="name">Андрій Мороз</field>
            <field name="beauty_role">client</field>
        </record>
        <record id="demo_client_3" model="res.partner">
            <field name="name">Марія Кравченко</field>
            <field name="beauty_role">client</field>
        </record>

        <record id="app_1" model="beauty.appointment">
            <field name="client_id" ref="demo_client_1"/>
            <field name="master_id" ref="demo_master_olena"/>
            <field name="service_ids" eval="[(4, ref('demo_service_coloring'))]"/>
            <field name="datetime_start">2026-03-02 10:00:00</field>
            <field name="state">done</field>
        </record>

        <record id="app_2" model="beauty.appointment">
            <field name="client_id" ref="demo_client_2"/>
            <field name="master_id" ref="demo_master_igor"/>
            <field name="service_ids" eval="[(4, ref('demo_service_manicure'))]"/>
            <field name="datetime_start">2026-03-10 14:30:00</field>
            <field name="state">confirmed</field>
        </record>

        <record id="app_3" model="beauty.appointment">
            <field name="client_id" ref="demo_client_3"/>
            <field name="master_id" ref="demo_master_natalia"/>
            <field name="service_ids" eval="[(4, ref('demo_service_massage'))]"/>
            <field name="datetime_start">2026-03-18 09:00:00</field>
            <field name="state">draft</field>
        </record>

        <record id="review_1" model="beauty.review">
            <field name="appointment_id" ref="app_1"/>
            <field name="rating">5</field>
            <field name="comment">Олена — найкращий колорист у Львові! Дуже задоволена кольором.</field>
        </record>
    </data>
</odoo>