<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bonus_report_wizard_form" model="ir.ui.view">
        <field name="name">beauty.bonus.report.wizard.form</field>
        <field name="model">beauty.bonus.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Calculate Master Bonuses">
                <group>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                    <group>
                        <field name="master_id" placeholder="All Masters"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_report" string="Print PDF" type="object" class="btn-primary" icon="fa-print"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bonus_report_wizard" model="ir.actions.act_window">
        <field name="name">Master Bonus Report</field>
        <field name="res_model">beauty.bonus.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field> 
    </record>

    <menuitem id="menu_beauty_reporting" 
              name="Reporting" 
              parent="menu_beauty_salon_root" 
              sequence="40"/>

    <menuitem id="menu_beauty_bonus_report" 
              name="Bonus Calculation" 
              parent="menu_beauty_reporting" 
              action="action_bonus_report_wizard" 
              sequence="10"/>
</odoo>